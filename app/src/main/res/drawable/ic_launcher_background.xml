<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon background. The launcher masks this to its own shape, so it is a flat
  fill edge to edge and carries no detail of its own - everything readable lives in the
  foreground layer, inside the guaranteed-visible centre.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item
                    android:offset="0"
                    android:color="#FF4C5FD7" />
                <item
                    android:offset="1"
                    android:color="#FF1B2352" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
