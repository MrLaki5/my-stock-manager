<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon foreground: a photo card with a metadata tag hanging off it.

  The 108x108 canvas is mostly bleed - only the middle 72x72 survives every launcher
  mask, so all of the artwork sits inside a radius of about 35 from the centre (54,54).

  The sun and mountain are knocked out of the card with evenOdd rather than drawn on top
  of it, so the whole layer is a single silhouette. That is what lets this same drawable
  serve as the <monochrome> layer for themed icons, where the system throws the colours
  away and keeps only the alpha. The tag is a separate shape with a real transparent gap
  between it and the card for the same reason: touching shapes would merge into one blob
  once tinted flat.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Photo card, with the sun and the ridge line cut out of it. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M34,29 L66,29 A5,5 0 0 1 71,34 L71,54 A5,5 0 0 1 66,59 L34,59 A5,5 0 0 1 29,54 L29,34 A5,5 0 0 1 34,29 Z M34,38 a4,4 0 1,0 8,0 a4,4 0 1,0 -8,0 Z M33,55 L43,40 L49,47 L57,37 L67,55 Z" />

    <!-- The tag. Amber so it reads as a separate object in the colour icon. -->
    <path
        android:fillColor="#FFFFC24B"
        android:fillType="evenOdd"
        android:pathData="M68,62 L77,71 L68,80 L59,71 Z M66.2,67 a1.8,1.8 0 1,0 3.6,0 a1.8,1.8 0 1,0 -3.6,0 Z" />
</vector>
